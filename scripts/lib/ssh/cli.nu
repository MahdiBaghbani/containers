# SSH CLI entry point

use ./key.nu

export def main [
    --generate-keypair (-g)  # Generate default SSH keypair
] {
    if $generate_keypair {
        key
    } else {
        print "DockyPody SSH management"
        print "Usage: nu scripts/lib/ssh/cli.nu --generate-keypair"
    }
}
