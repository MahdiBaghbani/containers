{
  "default": "debian",

  "defaults": {
    "dependencies": {
      "common-tools": {
        "service": "common-tools",
        "build_arg": "COMMON_TOOLS_IMAGE"
      }
    },
    "external_images": {
      "runtime": {
        "name": "quay.io/jupyterhub/k8s-hub",
        "build_arg": "BASE_HUB_IMAGE"
      }
    }
  },

  "platforms": [
    {
      "name": "debian",
      "dockerfile": "services/jupyterhub/Dockerfile"
    }
  ]
}
