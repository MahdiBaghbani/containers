{
  "default": "v6.1.0",
  "defaults": {
    "dependencies": {
      "common-tools": {
        "version": "v1.0.0-alpine"
      }
    },
    "external_images": {
      "node": {
        "tag": "24.15.0-trixie-slim"
      },
      "go": {
        "tag": "1.25-alpine"
      },
      "runtime": {
        "tag": "3.22"
      }
    },
    "build_args": {
      "EDITION": "stable",
      "GO_BUILD_GOPROXY": "https://proxy.golang.org|direct"
    },
    "sources": {
      "opencloud": {
        "url": "https://github.com/opencloud-eu/opencloud",
        "ref": "v6.1.0"
      }
    }
  },
  "versions": [
    {
      "name": "main",
      "latest": false,
      "overrides": {
        "build_args": {
          "EDITION": "rolling"
        },
        "sources": {
          "opencloud": {
            "ref": "main"
          }
        }
      }
    },
    {
      "name": "main-local-web-reva",
      "latest": false,
      "overrides": {
        "build_args": {
          "EDITION": "rolling"
        },
        "sources": {
          "opencloud": {
            "ref": "main"
          },
          "opencloud_web": {
            "path": "../opencloud-web"
          },
          "opencloud_reva": {
            "path": "../opencloud-reva"
          }
        }
      }
    },
    {
      "name": "v6.1.0-local-web-reva",
      "latest": false,
      "overrides": {
        "sources": {
          "opencloud_web": {
            "path": "../opencloud-web"
          },
          "opencloud_reva": {
            "path": "../opencloud-reva"
          }
        }
      }
    },
    {
      "name": "v6.1.0",
      "latest": true
    }
  ]
}
