{
  "default": "v8.9.1-nc-master",
  "defaults": {
    "sources": {
      "contacts": {
        "url": "https://github.com/nextcloud/contacts"
      }
    },
    "external_images": {
      "build": {
        "tag": "24-trixie-slim"
      }
    },
    "dependencies": {
      "common-tools": {
        "version": "v1.1.0-debian"
      },
      "nextcloud": {
        "version": "master-debian"
      }
    }
  },
  "versions": [
    {
      "name": "main-nc-master",
      "latest": false,
      "overrides": {
        "sources": {
          "contacts": {
            "ref": "main"
          }
        },
        "dependencies": {
          "nextcloud": {
            "version": "master-debian"
          }
        }
      }
    },
    {
      "name": "v8.9.1-nc-master",
      "latest": true,
      "overrides": {
        "sources": {
          "contacts": {
            "ref": "v8.9.1"
          }
        }
      }
    },
    {
      "name": "ocm-webapp-share",
      "latest": false,
      "overrides": {
        "sources": {
          "contacts": {
            "url": "https://github.com/sara-nl/nextcloud-contacts",
            "ref": "fix-undefined-group-ocm-invites-routes"
          }
        },
        "dependencies": {
          "nextcloud": {
            "version": "v35.0.1-debian"
          }
        }
      }
    }
  ]
}
