{
  "default": "v8.7.2-nc-master",

  "defaults": {
    "sources": {
      "contacts": {
        "url": "https://github.com/nextcloud/contacts"
      }
    },
    "external_images": {
      "build": {
        "tag": "24-trixie-slim"
      }
    },
    "dependencies": {
      "common-tools": {
        "version": "v1.0.0-debian"
      },
      "nextcloud": {
        "version": "master-debian"
      }
    }
  },

  "versions": [
    {
      "name": "main-nc-master",
      "latest": false,
      "overrides": {
        "sources": {
          "contacts": {
            "ref": "main"
          }
        },
        "dependencies": {
          "nextcloud": {
            "version": "master-debian"
          }
        }
      }
    },
    {
      "name": "v8.7.2-nc-master",
      "latest": true,
      "overrides": {
        "sources": {
          "contacts": {
            "ref": "v8.7.2"
          }
        }
      }
    },
    {
      "name": "ocm-contacts-app",
      "latest": false,
      "overrides": {
        "sources": {
          "contacts": {
            "url": "https://github.com/sara-nl/nextcloud-contacts",
            "ref": "invite-for-cloudid-exchange"
          }
        },
        "dependencies": {
          "nextcloud": {
            "version": "ocm-contacts-app-debian"
          }
        }
      }
    }
  ]
}
