ARG COMMON_TOOLS_IMAGE="common-tools:v1.0.0-debian"
ARG KASM_BASE_IMAGE="kasm-base:v1.4.1-debian"

FROM ${COMMON_TOOLS_IMAGE} AS common-tools

FROM ${KASM_BASE_IMAGE}

ARG NODE_VERSION="24.15.0"
ARG CHROME_VERSION="147.0.7727.101-1"
ARG CYPRESS_VERSION="15.14.1"

ARG TLS_ENABLED="false"
ARG TLS_MODE="disabled"
ARG TLS_CERT_NAME=""
ARG TLS_CA_NAME="dockypody"

USER root

# Make Node-based helpers (plugins, tasks) trust the DockyPody CA.
ENV NODE_EXTRA_CA_CERTS="/etc/ssl/certs/ca-certificates.crt"

# Copy internal CA bundle from common-tools (always copy, conditionally use).
RUN mkdir -p /etc/ssl/certs /tmp
COPY --from=common-tools /etc/ssl/certs/ca-certificates.crt /tmp/ca-bundle.crt
RUN if [ "$TLS_ENABLED" = "true" ] && [ "$TLS_MODE" != "cert-only" ]; then \
      mkdir -p /etc/ssl/certs && \
      cp /tmp/ca-bundle.crt /etc/ssl/certs/ca-certificates.crt && \
      echo "CA bundle copied from common-tools"; \
    else \
      echo "Internal CA bundle disabled (TLS disabled or cert-only mode)"; \
    fi && \
    rm -f /tmp/ca-bundle.crt

# Bake the DockyPody CA keypair into the image so cypress-autostart.nu can seed
# Cypress' internal proxy CA without runtime mounts.
COPY ./tls /tmp/tls-source/
RUN set -eux; \
    if [ "$TLS_ENABLED" = "true" ] && [ "$TLS_MODE" != "cert-only" ]; then \
      if [ -z "${TLS_CA_NAME:-}" ]; then TLS_CA_NAME="dockypody"; fi; \
      default_dir="/opt/dockypody/certificate-authority-default"; \
      mkdir -p "$default_dir"; \
      install -m 0644 -o 1000 -g 1000 "/tmp/tls-source/certificate-authority/${TLS_CA_NAME}.crt" "$default_dir/${TLS_CA_NAME}.crt"; \
      install -m 0600 -o 1000 -g 1000 "/tmp/tls-source/certificate-authority/${TLS_CA_NAME}.key" "$default_dir/${TLS_CA_NAME}.key"; \
      echo "Default DockyPody CA keypair installed for Cypress proxy seeding"; \
    else \
      echo "TLS disabled or cert-only mode: skipping default CA keypair install"; \
    fi && \
    rm -rf /tmp/tls-source || true

# Install pinned Node + Chrome + Cypress in the Kasm workspace.
RUN --mount=type=cache,id=common-tools-debian-apt-cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=common-tools-debian-apt-lists,target=/var/lib/apt/lists,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive \
    apt-get install \
    --no-install-recommends \
    --assume-yes \
    ca-certificates \
    curl \
    libasound2 \
    libgbm1 \
    libgtk-3-0 \
    libnss3 \
    libnss3-tools \
    libxss1 \
    xz-utils

RUN apt-get clean && rm -rf /var/lib/apt/lists/*

RUN --mount=type=cache,id=cypress-dl-node-v1-${NODE_VERSION}-linux-x64,target=/var/cache/dockypody/node,sharing=locked \
    set -eux; \
    if command -v node >/dev/null 2>&1; then rm -f /usr/local/bin/node /usr/local/bin/npm /usr/local/bin/npx || true; fi; \
    node_tar="/var/cache/dockypody/node/node-v${NODE_VERSION}-linux-x64.tar.xz"; \
    if [ -s "$node_tar" ]; then \
      tar -tJf "$node_tar" >/dev/null 2>&1 || rm -f "$node_tar"; \
    fi; \
    if [ ! -s "$node_tar" ]; then \
      tmp="${node_tar}.tmp"; \
      rm -f "$tmp"; \
      curl -fsSL --retry 3 --retry-delay 2 --connect-timeout 30 --max-time 600 -o "$tmp" \
        "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz"; \
      mv "$tmp" "$node_tar"; \
    fi; \
    tar -xJf "$node_tar" -C /usr/local --strip-components=1; \
    node --version | grep -F "v${NODE_VERSION}" >/dev/null 2>&1 || (echo "Node install failed" && exit 1); \
    npm --version >/dev/null

RUN --mount=type=cache,id=common-tools-debian-apt-cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=common-tools-debian-apt-lists,target=/var/lib/apt/lists,sharing=locked \
    --mount=type=cache,id=cypress-dl-chrome-v1-${CHROME_VERSION}-amd64,target=/var/cache/dockypody/chrome,sharing=locked \
    set -eux; \
    rm -f /etc/apt/apt.conf.d/docker-clean; \
    chrome_deb="/var/cache/dockypody/chrome/google-chrome-stable_${CHROME_VERSION}_amd64.deb"; \
    if [ -s "$chrome_deb" ]; then \
      dpkg-deb --info "$chrome_deb" >/dev/null 2>&1 || rm -f "$chrome_deb"; \
    fi; \
    if [ ! -s "$chrome_deb" ]; then \
      tmp="${chrome_deb}.tmp"; \
      rm -f "$tmp"; \
      curl -fsSL --retry 3 --retry-delay 2 --connect-timeout 30 --max-time 600 -o "$tmp" \
        "https://dl.google.com/linux/chrome/deb/pool/main/g/google-chrome-stable/google-chrome-stable_${CHROME_VERSION}_amd64.deb"; \
      mv "$tmp" "$chrome_deb"; \
    fi; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends --assume-yes "$chrome_deb"; \
    google-chrome --version | grep -F "${CHROME_VERSION%-*}" >/dev/null

RUN apt-get clean && rm -rf /var/lib/apt/lists/*

RUN --mount=type=cache,id=cypress-npm-cache,target=/root/.npm,sharing=locked \
    --mount=type=cache,id=cypress-dl-cypress-v1-${CYPRESS_VERSION}-linux-x64,target=/var/cache/dockypody/cypress,sharing=locked \
    set -eux; \
    export CYPRESS_CACHE_FOLDER="/var/cache/dockypody/cypress"; \
    export NPM_CONFIG_FETCH_RETRIES=5; \
    export NPM_CONFIG_FETCH_RETRY_MINTIMEOUT=10000; \
    export NPM_CONFIG_FETCH_RETRY_MAXTIMEOUT=60000; \
    export NPM_CONFIG_FETCH_TIMEOUT=300000; \
    for attempt in 1 2 3; do \
      if npm install --global --unsafe-perm "cypress@${CYPRESS_VERSION}"; then \
        break; \
      fi; \
      if [ "$attempt" -eq 3 ]; then \
        echo "Cypress npm install failed after 3 attempts" && exit 1; \
      fi; \
      sleep $((attempt * 2)); \
    done; \
    cypress --version | grep -F "${CYPRESS_VERSION}" >/dev/null 2>&1 || \
      (echo "Cypress version mismatch after install (expected ${CYPRESS_VERSION})" && exit 1); \
    mkdir -p /home/ocm-user/.cache/Cypress; \
    cp -a /var/cache/dockypody/cypress/. /home/ocm-user/.cache/Cypress/; \
    chown -R 1000:0 /home/ocm-user/.cache/Cypress; \
    chmod -R g=u /home/ocm-user/.cache/Cypress

COPY --chmod=755 ./scripts/custom_startup.sh /dockerstartup/custom_startup.sh
COPY --chmod=755 ./scripts/cypress-autostart.nu /dockerstartup/cypress-autostart.nu
COPY ./assets/cypress.desktop /tmp/cypress.desktop

RUN install -D -m 0644 /tmp/cypress.desktop /usr/share/applications/cypress.desktop && \
    install -D -m 0755 -o 1000 -g 0 /tmp/cypress.desktop /home/kasm-default-profile/Desktop/cypress.desktop && \
    rm -f /tmp/cypress.desktop

RUN mkdir -p /home/ocm-user/.cache /home/ocm-user/.config /home/ocm-user/.local /home/ocm-user/.npm && \
    chown 1000:0 /home/ocm-user/.cache && \
    chmod g=u /home/ocm-user/.cache && \
    chown -R 1000:0 /home/ocm-user/.config /home/ocm-user/.local /home/ocm-user/.npm && \
    chmod -R g=u /home/ocm-user/.config /home/ocm-user/.local /home/ocm-user/.npm

ENV CYPRESS_CACHE_FOLDER="/home/ocm-user/.cache/Cypress"
ENV XDG_CACHE_HOME="/home/ocm-user/.cache"
ENV OCM_DEFAULT_WEB_BROWSER="chrome"
ENV OCM_CYPRESS_MAXIMIZE="true"

USER 1000
