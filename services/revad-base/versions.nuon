{
  "default": "master",

  "defaults": {
    "build_args": {
      "GO_BUILD_GOPROXY": "https://proxy.golang.org|direct"
    },
    "sources": {
      "revad": {
        "url": "https://github.com/cs3org/reva",
        "ref": "fix/ocm-incoming-share-user-id-normalization"
      }
    },
    "external_images": {
      "build": {
        "tag": "1.25-trixie"
      }
    },
    "dependencies": {
      "common-tools": {
        "version": "v1.0.0-debian"
      }
    },
    "platforms": {
      "production": {
        "external_images": {
          "runtime": {
            "tag": "nonroot"
          }
        }
      },
      "development": {
        "external_images": {
          "runtime": {
            "tag": "trixie-slim"
          }
        }
      }
    }
  },

  "versions": [
    {
      "name": "master",
      "latest": false,
      "overrides": {
        "sources": {
          "revad": {
            "ref": "fix/ocm-incoming-share-user-id-normalization"
          }
        },
        "build_args": {
          "REVA_CONFIG_BAND": "master"
        }
      }
    },
    {
      "name": "ocm-webapp-share",
      "latest": false,
      "overrides": {
        "sources": {
          "revad": {
            "ref": "sta-milestone-8/ocm-webapp-open-in-app"
          }
        },
        "build_args": {
          "REVA_CONFIG_BAND": "master"
        }
      }
    },
    {
      "name": "v3.10.1",
      "latest": true,
      "overrides": {
        "sources": {
          "revad": {
            "ref": "v3.10.1"
          }
        },
        "build_args": {
          "REVA_CONFIG_BAND": "v3.10.1"
        }
      }
    }
  ]
}
