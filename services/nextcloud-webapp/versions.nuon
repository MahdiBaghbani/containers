{
  "default": "webapp-share",

  "defaults": {
    "sources": {
      "integration_jupyterhub": {
        "url": "https://github.com/MahdiBaghbani/nextcloud-integration_jupyterhub"
      },
      "ocmremotewebapp": {
        "url": "https://github.com/SUNET/ocmremotewebapp"
      }
    },
    "external_images": {
      "build": {
        "tag": "20-trixie-slim"
      }
    },
    "dependencies": {
      "common-tools": {
        "version": "v1.0.0-debian"
      },
      "nextcloud-contacts": {
        "version": "ocm-webapp-share-debian"
      }
    }
  },

  "versions": [
    {
      "name": "webapp-share",
      "latest": true,
      "overrides": {
        "sources": {
          "integration_jupyterhub": {
            "ref": "sta-milestone-8/webapp-share-folder-webdav-discovery"
          },
          "ocmremotewebapp": {
            "ref": "main"
          }
        }
      }
    }
  ]
}
