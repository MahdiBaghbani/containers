{
  "default": "webapp-share",
  "defaults": {
    "sources": {
      "integration_jupyterhub": {
        "url": "https://github.com/MahdiBaghbani/nextcloud-integration_jupyterhub"
      },
      "ocmremotewebapp": {
        "url": "https://github.com/SUNET/ocmremotewebapp"
      }
    },
    "external_images": {
      "build": {
        "tag": "20-trixie-slim"
      }
    },
    "dependencies": {
      "common-tools": {
        "version": "v1.1.0-debian"
      },
      "nextcloud-contacts": {
        "version": "ocm-webapp-share-debian"
      }
    }
  },
  "versions": [
    {
      "name": "webapp-share",
      "latest": true,
      "overrides": {
        "sources": {
          "integration_jupyterhub": {
            "url": "https://github.com/SUNET/nextcloud-integration_jupyterhub",
            "ref": "main"
          },
          "ocmremotewebapp": {
            "ref": "50e99b14c937c850367401ee7d593e1b1d78f17c"
          }
        }
      }
    }
  ]
}
