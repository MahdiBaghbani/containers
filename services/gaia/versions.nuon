{
  "default": "master",

  "defaults": {
    "build_args": {
      "GO_BUILD_GOPROXY": "https://proxy.golang.org|direct"
    },
    "sources": {
      "gaia": {
        "url": "https://github.com/cs3org/gaia",
        "ref": "master"
      }
    },
    "external_images": {
      "build": {
        "tag": "1.25-trixie"
      },
      "runtime": {
        "tag": "trixie-slim"
      }
    },
    "dependencies": {
      "common-tools": {
        "version": "v1.0.0-debian"
      }
    }
  },

  "versions": [
    {
      "name": "master",
      "latest": true
    }
  ]
}
