{
  "default": "master",
  "defaults": {
    "build_args": {
      "GO_BUILD_GOPROXY": "https://proxy.golang.org|direct"
    },
    "sources": {
      "revad": {
        "url": "https://github.com/cs3org/reva",
        "ref": "a330ea44996d60a57ae100e93278b00596aca181"
      },
      "revad_plugins": {
        "url": "https://github.com/cernbox/reva-plugins",
        "ref": "v0.0.43"
      }
    },
    "external_images": {
      "build": {
        "tag": "1.27.1-trixie"
      }
    },
    "dependencies": {
      "common-tools": {
        "version": "v1.1.0-debian"
      },
      "gaia": {
        "version": "master",
        "single_platform": true
      }
    }
  },
  "versions": [
    {
      "name": "master",
      "latest": false,
      "overrides": {
        "sources": {
          "revad": {
            "ref": "a330ea44996d60a57ae100e93278b00596aca181"
          }
        },
        "platforms": {
          "production": {
            "dependencies": {
              "revad-base": {
                "version": "master-production"
              }
            }
          },
          "development": {
            "dependencies": {
              "revad-base": {
                "version": "master-development"
              }
            }
          }
        }
      }
    },
    {
      "name": "ocm-webapp-share",
      "latest": false,
      "overrides": {
        "sources": {
          "revad": {
            "ref": "a330ea44996d60a57ae100e93278b00596aca181"
          }
        },
        "platforms": {
          "production": {
            "dependencies": {
              "revad-base": {
                "version": "ocm-webapp-share-production"
              }
            }
          },
          "development": {
            "dependencies": {
              "revad-base": {
                "version": "ocm-webapp-share-development"
              }
            }
          }
        }
      }
    },
    {
      "name": "v3.13.1",
      "latest": true,
      "overrides": {
        "sources": {
          "revad": {
            "ref": "v3.13.1"
          }
        },
        "platforms": {
          "production": {
            "dependencies": {
              "revad-base": {
                "version": "v3.13.1-production"
              }
            }
          },
          "development": {
            "dependencies": {
              "revad-base": {
                "version": "v3.13.1-development"
              }
            }
          }
        }
      }
    }
  ]
}
