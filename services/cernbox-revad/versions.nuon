{
  "default": "master",

  "defaults": {
    "build_args": {
      "GO_BUILD_GOPROXY": "https://proxy.golang.org|direct"
    },
    "sources": {
      "revad": {
        "url": "https://github.com/cs3org/reva",
        "ref": "master"
      },
      "revad_plugins": {
        "url": "https://github.com/cernbox/reva-plugins",
        "ref": "master"
      }
    },
    "external_images": {
      "build": {
        "tag": "1.25-trixie"
      }
    },
    "dependencies": {
      "common-tools": {
        "version": "v1.0.0-debian"
      },
      "gaia": {
        "version": "master",
        "single_platform": true
      }
    }
  },

  "versions": [
    {
      "name": "master",
      "latest": false,
      "overrides": {
        "sources": {
          "revad": {
            "ref": "master"
          }
        },
        "platforms": {
          "production": {
            "dependencies": {
              "revad-base": {
                "version": "master-production"
              }
            }
          },
          "development": {
            "dependencies": {
              "revad-base": {
                "version": "master-development"
              }
            }
          }
        }
      }
    },
    {
      "name": "v3.10.1",
      "latest": true,
      "overrides": {
        "sources": {
          "revad": {
            "ref": "v3.10.1"
          },
          "revad_plugins": {
            "ref": "39c4d38a5761629473fe553524f4c2bbb27c0b1b"
          }
        },
        "platforms": {
          "production": {
            "dependencies": {
              "revad-base": {
                "version": "v3.10.1-production"
              }
            }
          },
          "development": {
            "dependencies": {
              "revad-base": {
                "version": "v3.10.1-development"
              }
            }
          }
        }
      }
    }
  ]
}
