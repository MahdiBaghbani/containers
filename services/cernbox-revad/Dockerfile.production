ARG BASE_BUILD_IMAGE="golang:1.25-trixie"
ARG REVAD_BASE_IMAGE="revad-base:v3.3.3-production"
ARG GAIA_IMAGE="gaia:master"
ARG COMMON_TOOLS_IMAGE="common-tools:v1.0.0-debian"

################################
###  Import Gaia image       ###
################################
FROM ${GAIA_IMAGE} AS gaia

################################
###  Common Tools (nu)       ###
################################
FROM ${COMMON_TOOLS_IMAGE} AS common-tools-builder

################################
###  Build Reva with Gaia    ###
################################
FROM ${BASE_BUILD_IMAGE} AS build

ENV CGO_ENABLED=1

RUN --mount=type=cache,id=common-tools-debian-apt-cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=common-tools-debian-apt-lists,target=/var/lib/apt/lists,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive \
    apt-get install \
    --no-install-recommends \
    --assume-yes \
    bash \
    binutils \
    ca-certificates \
    git \
    musl-tools;

RUN apt-get clean && rm -rf /var/lib/apt/lists/*

COPY --from=gaia /usr/local/bin/gaia /usr/local/bin/gaia
COPY --chmod=755 --from=common-tools-builder /usr/local/bin/nu /usr/local/bin/nu
RUN nu --version || (echo "Nushell verification failed" && exit 1)

WORKDIR /

ARG REVAD_URL="https://github.com/cs3org/reva"
ARG REVAD_REF="v3.3.3"
ARG REVAD_SHA=""
ARG REVAD_REF_KIND=""
ARG REVAD_PATH=""
ARG REVAD_MODE=""
ARG REVAD_PLUGINS_URL="https://github.com/cernbox/reva-plugins"
ARG REVAD_PLUGINS_REF="master"
ARG REVAD_PLUGINS_REF_KIND=""
ARG GO_BUILD_GOPROXY=""
ARG CACHEBUST="default"

COPY --chmod=755 ./scripts/lib/clone-source.nu /tmp/clone-source.nu

# Clone or copy reva source via shared helper (local bind mount or git cache).
# The helper auto-detects ref vs SHA and manages the shared git cache.
RUN --mount=type=cache,id=cernbox-revad-reva-git-${CACHEBUST:-${REVAD_REF}},target=/src/reva-git-cache,sharing=shared \
    --mount=type=bind,source=${REVAD_PATH:-.},target=/tmp/local-reva,ro \
    nu /tmp/clone-source.nu \
    --mode "${REVAD_MODE:-git}" \
    --url "${REVAD_URL}" \
    --ref "${REVAD_REF}" \
    --local-dir /tmp/local-reva \
    --cache-dir /src/reva-git-cache \
    --dest /reva-git

# Clone reva-plugins source via shared helper (git cache).
RUN --mount=type=cache,id=cernbox-revad-reva-plugins-git-${CACHEBUST:-${REVAD_PLUGINS_REF}},target=/src/reva-plugins-git-cache,sharing=shared \
    nu /tmp/clone-source.nu \
    --mode git \
    --url "${REVAD_PLUGINS_URL}" \
    --ref "${REVAD_PLUGINS_REF}" \
    --cache-dir /src/reva-plugins-git-cache \
    --dest /reva-plugins-git

RUN --mount=type=cache,id=cernbox-revad-go-mod-cache,target=/go/pkg/mod,sharing=locked \
    --mount=type=cache,id=cernbox-revad-go-build-cache,target=/root/.cache/go-build,sharing=locked \
    if [ -n "$GO_BUILD_GOPROXY" ]; then \
    GOPROXY="$GO_BUILD_GOPROXY" gaia build \
    --with github.com/cernbox/reva-plugins=/reva-plugins-git \
    --with github.com/cs3org/reva/v3=/reva-git \
    --static-musl \
    --output /revad; \
    else \
    gaia build \
    --with github.com/cernbox/reva-plugins=/reva-plugins-git \
    --with github.com/cs3org/reva/v3=/reva-git \
    --static-musl \
    --output /revad; \
    fi

RUN ldd /revad 2>&1 | grep -q "not a dynamic executable" || \
    (echo "ERROR: Binary is not statically linked" && exit 1) && \
    echo "Binary is statically linked"

####################################
###  Compress binary with UPX    ###
####################################
FROM ${COMMON_TOOLS_IMAGE} AS compress

RUN mkdir -p /tmp/binaries

COPY --from=build /revad /tmp/binaries/revad

ARG PACK_WITH_UPX="true"
RUN if [ "${PACK_WITH_UPX}" = "true" ]; then \
    strip -s /tmp/binaries/revad || true; \
    upx -qq --best --lzma /tmp/binaries/revad && upx -t /tmp/binaries/revad; \
    fi

################################
###     Directory builder    ###
################################
FROM ${BASE_BUILD_IMAGE} AS directory

# Create directories for localhome storage
# With virtual_home_template="/home/{{.Username}}", localhome exposes paths under
# /home/{username}/ (via gateway mount_path="/") while storing files in
# /revalocalstorage/data/{username}/
RUN mkdir -p /revalocalstorage/data/marie && \
    mkdir -p /revalocalstorage/data/einstein && \
    mkdir -p /revalocalstorage/data/richard && \
    mkdir -p /revalocalstorage/.shadow/recycle_bin/marie && \
    mkdir -p /revalocalstorage/.shadow/versions/marie && \
    mkdir -p /revalocalstorage/.shadow/references/marie && \
    mkdir -p /revalocalstorage/.shadow/recycle_bin/einstein && \
    mkdir -p /revalocalstorage/.shadow/versions/einstein && \
    mkdir -p /revalocalstorage/.shadow/references/einstein && \
    mkdir -p /revalocalstorage/.shadow/recycle_bin/richard && \
    mkdir -p /revalocalstorage/.shadow/versions/richard && \
    mkdir -p /revalocalstorage/.shadow/references/richard && \
    chown -R 65532:65532 /revalocalstorage && \
    chmod 755 /revalocalstorage

##############################
###   Production Runtime   ###
##############################
FROM ${REVAD_BASE_IMAGE}

COPY --from=directory --chown=65532:65532 /revalocalstorage /revalocalstorage
COPY --from=compress --chmod=755 /tmp/binaries/revad /revad/cmd/revad
