ARG COMMON_TOOLS_IMAGE="common-tools:v1.0.0-alpine"
ARG BASE_NODE_IMAGE="node:24.15.0-trixie-slim"
ARG BASE_GO_IMAGE="golang:1.25-alpine"
ARG BASE_RUNTIME_IMAGE="alpine:3.23.4"

ARG TLS_ENABLED="false"
ARG TLS_MODE="disabled"
ARG TLS_CERT_NAME=""
ARG TLS_CA_NAME=""

ARG SSH_ENABLED="false"
ARG SSH_MODE="disabled"
ARG SSH_DEFAULT_USER="root"
ARG SSH_PORT="22"
ARG SSH_LISTEN="0.0.0.0"

FROM ${COMMON_TOOLS_IMAGE} AS common-tools

FROM ${BASE_NODE_IMAGE} AS generate

ARG OCIS_MODE=""
ARG OCIS_URL="https://github.com/owncloud/ocis"
ARG OCIS_REF="master"
ARG OCIS_SHA=""
ARG OCIS_REF_KIND=""
ARG OCIS_PATH=""

ARG OCIS_WEB_MODE=""
ARG OCIS_WEB_URL=""
ARG OCIS_WEB_REF=""
ARG OCIS_WEB_SHA=""
ARG OCIS_WEB_REF_KIND=""
ARG OCIS_WEB_PATH=""
ARG OCIS_WEB_NODE_OPTIONS="--max-old-space-size=4096"

ARG CACHEBUST="default"

RUN --mount=type=cache,id=ocis-debian-apt-cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=ocis-debian-apt-lists,target=/var/lib/apt/lists,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive \
    apt-get install \
    --no-install-recommends \
    --assume-yes \
      bash \
      build-essential \
      ca-certificates \
      curl \
      git \
      gzip \
      make \
      python3; \
    apt-get clean && rm -rf /var/lib/apt/lists/*

COPY --chmod=755 --from=common-tools /usr/local/bin/nu /usr/local/bin/nu
COPY --chmod=755 ./scripts/lib/clone-source.nu /usr/local/bin/clone-source.nu
COPY --chmod=755 ./scripts/build/web-override.nu /usr/local/bin/web-override.nu

WORKDIR /ocis

# Clone or copy ocis source via shared helper (local bind mount or git cache).
RUN --mount=type=bind,source=${OCIS_PATH:-.},target=/mnt/src,ro \
    --mount=type=cache,id=ocis-git-${CACHEBUST:-${OCIS_REF}},target=/src/ocis-git-cache,sharing=shared \
    nu /usr/local/bin/clone-source.nu \
    --mode "${OCIS_MODE:-git}" \
    --url "${OCIS_URL}" \
    --ref "${OCIS_REF}" \
    --ref-kind "${OCIS_REF_KIND}" \
    --local-dir /mnt/src \
    --cache-dir /src/ocis-git-cache \
    --dest /ocis && \
    if [ "${OCIS_MODE:-git}" != "local" ] && [ -n "$OCIS_SHA" ]; then \
      if ! git -C /ocis checkout "$OCIS_SHA"; then \
        git -C /ocis fetch --depth 1 origin "$OCIS_SHA" && \
        git -C /ocis checkout "$OCIS_SHA"; \
      fi; \
    fi

RUN corepack enable

RUN --mount=type=cache,id=ocis-pnpm-store,target=/root/.local/share/pnpm/store,sharing=locked \
    --mount=type=cache,id=ocis-pnpm-cache,target=/root/.cache/pnpm,sharing=locked \
    --mount=type=bind,source=${OCIS_WEB_PATH:-.},target=/mnt/web,ro \
    --mount=type=cache,id=ocis-web-git-${CACHEBUST:-${OCIS_WEB_REF}},target=/src/ocis-web-git-cache,sharing=shared \
    nu /usr/local/bin/web-override.nu

FROM ${BASE_GO_IMAGE} AS build

ARG TARGETARCH="amd64"
ARG GO_BUILD_GOPROXY=""
ARG OCIS_REVA_MODE=""
ARG OCIS_REVA_URL=""
ARG OCIS_REVA_REF=""
ARG OCIS_REVA_SHA=""
ARG OCIS_REVA_REF_KIND=""
ARG OCIS_REVA_PATH=""
ARG CACHEBUST="default"

RUN --mount=type=cache,id=common-tools-alpine-apk-cache,target=/var/cache/apk,sharing=locked \
    apk add --no-cache \
      bash \
      build-base \
      git \
      make \
      pkgconf \
      vips-dev

WORKDIR /ocis

COPY --from=generate /ocis/ /ocis/

COPY --chmod=755 --from=common-tools /usr/local/bin/nu /usr/local/bin/nu
COPY --chmod=755 ./scripts/lib/clone-source.nu /usr/local/bin/clone-source.nu
COPY --chmod=755 ./scripts/build/reva-override.nu /usr/local/bin/reva-override.nu

RUN --mount=type=bind,source=${OCIS_REVA_PATH:-.},target=/mnt/reva,ro \
    --mount=type=cache,id=ocis-reva-git-${CACHEBUST:-${OCIS_REVA_REF}},target=/src/ocis-reva-git-cache,sharing=shared \
    nu /usr/local/bin/reva-override.nu

RUN --mount=type=cache,id=ocis-go-mod-cache,target=/go/pkg/mod,sharing=locked \
    --mount=type=cache,id=ocis-go-build-cache,target=/root/.cache/go-build,sharing=locked \
    make -C ocis release-linux-docker-${TARGETARCH} ENABLE_VIPS=true DIST=/dist

FROM ${BASE_RUNTIME_IMAGE}

ARG TARGETARCH="amd64"
ARG TLS_ENABLED
ARG TLS_MODE
ARG TLS_CERT_NAME
ARG TLS_CA_NAME

ARG SSH_ENABLED
ARG SSH_MODE
ARG SSH_DEFAULT_USER
ARG SSH_PORT
ARG SSH_LISTEN

USER root

RUN --mount=type=cache,id=common-tools-alpine-apk-cache,target=/var/cache/apk,sharing=locked \
    apk add --no-cache \
      attr \
      bash \
      ca-certificates \
      curl \
      libc6-compat \
      mailcap \
      openssh-server \
      su-exec \
      tree \
      vips && \
    echo 'hosts: files dns' > /etc/nsswitch.conf

RUN mkdir -p /etc/ssl/certs /tmp
COPY --from=common-tools /etc/ssl/certs/ca-certificates.crt /tmp/ca-bundle.crt
RUN if [ "$TLS_ENABLED" = "true" ] && [ "$TLS_MODE" != "cert-only" ]; then \
      cp /tmp/ca-bundle.crt /etc/ssl/certs/ca-certificates.crt && \
      echo "CA bundle copied from common-tools"; \
    else \
      echo "Internal CA bundle disabled (TLS disabled or cert-only mode)"; \
    fi && \
    rm -f /tmp/ca-bundle.crt

COPY --chmod=755 --from=common-tools /usr/local/bin/nu /usr/local/bin/nu
COPY --chmod=755 --from=common-tools /usr/bin/tini-static /usr/bin/tini

COPY --from=build --chmod=755 /dist/binaries/ocis-linux-${TARGETARCH} /usr/bin/ocis

RUN addgroup -g 1000 -S ocis && adduser -S -D -u 1000 -G ocis ocis
RUN mkdir -p /etc/ocis /var/lib/ocis && chown -R 1000:1000 /etc/ocis /var/lib/ocis

VOLUME ["/etc/ocis", "/var/lib/ocis"]

COPY ./configs/ /opt/dockypody/templates/ocis/

RUN mkdir -p /tls

COPY ./tls /tmp/tls-source/
COPY --chmod=755 ./scripts/tls/copy-tls.nu /tmp/copy-tls.nu

RUN if [ "$TLS_ENABLED" = "true" ] && [ "$TLS_MODE" = "ca-only" ]; then \
      echo "CA-only mode: CA bundle copied via COPY --from=common-tools, copy-tls.nu skipped" && \
      rm -rf /tmp/tls-source /tmp/copy-tls.nu || true; \
    elif [ "$TLS_ENABLED" = "true" ] && [ "$TLS_MODE" != "ca-only" ]; then \
      if [ ! -f /tmp/copy-tls.nu ]; then \
        echo "Error: copy-tls.nu not found. This should not happen for non-ca-only modes." && exit 1; \
      fi && \
      nu /tmp/copy-tls.nu \
      --enabled "'$TLS_ENABLED'" \
      --mode "'$TLS_MODE'" \
      --ca-name "'$TLS_CA_NAME'" \
      --cert-name "'$TLS_CERT_NAME'" \
      --source-certs /tmp/tls-source/certificates/ \
      --dest /tls/ \
      --runtime-owner "'1000:1000'" && \
      rm -rf /tmp/tls-source /tmp/copy-tls.nu; \
    else \
      echo "TLS disabled: skipping service TLS install"; \
      rm -rf /tmp/tls-source /tmp/copy-tls.nu || true; \
    fi

COPY ./ssh /tmp/ssh-build-context/
RUN if [ "$SSH_ENABLED" = "true" ] && { [ "$SSH_MODE" = "server" ] || [ "$SSH_MODE" = "client-and-server" ]; }; then \
      mkdir -p /opt/dockypody/ssh && \
      for pub in /tmp/ssh-build-context/*.pub; do \
        if [ -f "$pub" ]; then \
          cp "$pub" /opt/dockypody/ssh/ && \
          echo "SSH public key installed"; \
        fi; \
      done; \
      if [ -f /tmp/ssh-build-context/ssh.json ]; then \
        cp /tmp/ssh-build-context/ssh.json /opt/dockypody/ssh/ssh.json && \
        chmod 0644 /opt/dockypody/ssh/ssh.json; \
      else \
        echo "Warning: ssh.json not found in build context; ssh key_name defaults apply" >&2; \
      fi; \
      if [ "$SSH_MODE" = "client-and-server" ]; then \
        for src in /tmp/ssh-build-context/*; do \
          if [ ! -f "$src" ]; then continue; fi; \
          base="$(basename "$src")"; \
          case "$base" in \
            *.pub|ssh.json|known_hosts) \
              ;; \
            *) \
              cp "$src" "/opt/dockypody/ssh/$base" && \
              chmod 0640 "/opt/dockypody/ssh/$base"; \
              ;; \
          esac; \
        done; \
      fi; \
    else \
      echo "SSH disabled or not in server/client-and-server mode, skipping SSH install"; \
    fi && \
    rm -rf /tmp/ssh-build-context || true

ENV OCM_SSH_ENABLED="${SSH_ENABLED}" \
    OCM_SSH_MODE="${SSH_MODE}" \
    OCM_SSH_DEFAULT_USER="${SSH_DEFAULT_USER}" \
    OCM_SSH_PORT="${SSH_PORT}" \
    OCM_SSH_LISTEN="${SSH_LISTEN}"

ENV DOCKYPODY_TLS_CERT_NAME="${TLS_CERT_NAME}"

COPY --chmod=755 ./scripts/entrypoint.sh /usr/bin/entrypoint.sh
COPY --chmod=755 ./scripts/entrypoint-init.nu /usr/bin/entrypoint-init.nu
COPY --chmod=755 ./scripts/lib/sshd.nu /usr/bin/lib/sshd.nu
COPY --chmod=755 ./scripts/lib/ocmproviders.nu /usr/bin/lib/ocmproviders.nu

EXPOSE 9200

ENTRYPOINT ["/usr/bin/tini", "-g", "--", "/usr/bin/entrypoint.sh"]
CMD ["/usr/bin/ocis", "server"]
