{
  "default": "v34.0.1",

  "defaults": {
    "sources": {
      "nextcloud": {
        "url": "https://github.com/nextcloud/server",
      }
    },
    "dependencies": {
      "nextcloud-base": {
        "version": "8.3-apache-debian"
      },
      "common-tools": {
        "version": "v1.0.0-debian"
      }
    }
  },

  "versions": [
    {
      "name": "master",
      "latest": false,
      "overrides": {
        "sources": {
          "nextcloud": {
            "ref": "master"
          }
        }
      }
    },
    {
      "name": "v34.0.1",
      "latest": true,
      "overrides": {
        "sources": {
          "nextcloud": {
            "ref": "v34.0.1"
          }
        }
      }
    },
    {
      "name": "v33.0.6",
      "latest": false,
      "overrides": {
        "sources": {
          "nextcloud": {
            "ref": "v33.0.6"
          }
        }
      }
    },
    {
      "name": "v32.0.12",
      "latest": false,
      "overrides": {
        "sources": {
          "nextcloud": {
            "ref": "v32.0.12"
          }
        }
      }
    },
    {
      "name": "ocm-contacts-app",
      "latest": false,
      "overrides": {
        "sources": {
          "nextcloud": {
            "url": "https://github.com/redblom/nextcloud-server.git",
            "ref": "move-ocm-invite-accepted-route-impl-to-contacts-app"
          }
        }
      }
    }
  ]
}
