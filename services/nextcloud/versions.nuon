{
  "default": "v35.0.1",

  "defaults": {
    "sources": {
      "nextcloud": {
        "url": "https://github.com/nextcloud/server",
      }
    },
    "dependencies": {
      "nextcloud-base": {
        "version": "8.3-apache-debian"
      },
      "common-tools": {
        "version": "v1.1.0-debian"
      }
    }
  },

  "versions": [
    {
      "name": "master",
      "latest": false,
      "overrides": {
        "sources": {
          "nextcloud": {
            "ref": "master"
          }
        }
      }
    },
    {
      "name": "v35.0.1",
      "latest": true,
      "overrides": {
        "sources": {
          "nextcloud": {
            "ref": "v35.0.1"
          }
        }
      }
    },
    {
      "name": "v34.0.4",
      "latest": false,
      "overrides": {
        "sources": {
          "nextcloud": {
            "ref": "v34.0.4"
          }
        }
      }
    },
    {
      "name": "v33.0.9",
      "latest": false,
      "overrides": {
        "sources": {
          "nextcloud": {
            "ref": "v33.0.9"
          }
        }
      }
    }
  ]
}
