{
  "default": "v32.0.2",

  "defaults": {
    "sources": {
      "nextcloud": {
        "url": "https://github.com/nextcloud/server",
        "ref": "v32.0.2"
      }
    },
    "dependencies": {
      "nextcloud-base": {
        "version": "8.3-apache-debian"
      }
    }
  },

  "versions": [
    {
      "name": "master",
      "latest": false,
      "overrides": {
        "sources": {
          "nextcloud": {
            "ref": "master"
          }
        }
      }
    },
    {
      "name": "v32.0.2",
      "latest": true,
      "overrides": {
        "sources": {
          "nextcloud": {
            "ref": "v32.0.2"
          }
        }
      }
    },
    // Enrique's Nextcloud server with OCM code-flow support
    // Local clone: .repos/enrique-nc-server (origin: https://github.com/enriquepablo/server.git)
    // TODO: pin to a stable tag/commit once Enrique cuts a release
    {
      "name": "v33-codeflow",
      "latest": false,
      "overrides": {
        "sources": {
          "nextcloud": {
            "url": "https://github.com/enriquepablo/server.git",
            "ref": "master"
          }
        }
      }
    },
    // Local build for OCM code-flow development (Enrique's NC from .repos/enrique-nc-server)
    {
      "name": "local-ocm-code-flow",
      "latest": false,
      "overrides": {
        "sources": {
          "nextcloud": {
            "path": ".repos/enrique-nc-server"
          }
        }
      }
    }
  ]
}
