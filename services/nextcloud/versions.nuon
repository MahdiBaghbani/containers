{
  "default": "v33.0.3",

  "defaults": {
    "sources": {
      "nextcloud": {
        "url": "https://github.com/nextcloud/server",
        "ref": "v33.0.2"
      }
    },
    "dependencies": {
      "nextcloud-base": {
        "version": "8.3-apache-debian"
      },
      "common-tools": {
        "version": "v1.0.0-debian"
      }
    }
  },

  "versions": [
    {
      "name": "master",
      "latest": false,
      "overrides": {
        "sources": {
          "nextcloud": {
            "ref": "master"
          }
        }
      }
    },
    {
      "name": "v33.0.3",
      "latest": true
    },
    {
      "name": "v32.0.9",
      "latest": false,
      "overrides": {
        "sources": {
          "nextcloud": {
            "ref": "v32.0.9"
          }
        }
      }
    },
    {
      "name": "v34-codeflow",
      "latest": false,
      "overrides": {
        "sources": {
          "nextcloud": {
            "url": "https://github.com/enriquepablo/server.git",
            "ref": "master"
          }
        }
      }
    },
    {
      "name": "sta-ocm-m6",
      "latest": false,
      "overrides": {
        "sources": {
          "nextcloud": {
            "url": "https://github.com/MahdiBaghbani/server.git",
            "ref": "sta-milestone-6/ocm-code-flow"
          }
        }
      }
    },
    {
      "name": "sta-m6-nc-code-flow-arch-redesign",
      "latest": false,
      "overrides": {
        "sources": {
          "nextcloud": {
            "url": "https://github.com/MahdiBaghbani/server.git",
            "ref": "sta-milestone-6/ocm-architecture-redesign"
          }
        }
      }
    }
  ]
}
