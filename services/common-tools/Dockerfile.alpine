ARG BASE_RUNTIME_IMAGE="alpine:3.22"
ARG NUSHELL_REF="0.113.1"
ARG NUSHELL_URL="https://github.com/nushell/nushell"
ARG TINI_REF="v0.19.0"
ARG TINI_URL="https://github.com/krallin/tini"
ARG UPX_REF="v5.0.2"
ARG UPX_URL="https://github.com/upx/upx"
ARG TLS_ENABLED="false"
ARG TLS_CA_NAME=""

FROM ${BASE_RUNTIME_IMAGE} AS upx-build

ARG UPX_REF
ARG UPX_URL
ARG CACHEBUST="default"

RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.edge.kernel.org/g' /etc/apk/repositories
RUN --mount=type=cache,id=common-tools-alpine-apk-cache,target=/var/cache/apk,sharing=locked \
    apk add \
    build-base \
    ca-certificates \
    cmake \
    git \
    musl-dev \
    zlib-dev;

WORKDIR /src/upx
# Cache git clone: shared cache across all platforms, since it's the same UPX_REF
# Cache ID includes UPX_REF, so cache invalidates when version changes.
RUN --mount=type=cache,id=upx-git-${CACHEBUST:-${UPX_REF}},target=/src/upx-git-cache,sharing=shared \
    mkdir -p /src/upx-git-cache && \
    if [ ! -d /src/upx-git-cache/.git ]; then \
    git clone --branch "${UPX_REF}" --depth 1 --recurse-submodules ${UPX_URL} /src/upx-git-cache; \
    fi && \
    cp -a /src/upx-git-cache/. . && \
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release && \
    cmake --build build -j"$(nproc)" || (echo "UPX build failed" && exit 1)

# Tools stage
FROM ${BASE_RUNTIME_IMAGE} AS tools

ARG NUSHELL_REF
ARG NUSHELL_URL
ARG TINI_REF
ARG TINI_URL
ARG TLS_ENABLED
ARG TLS_CA_NAME
ARG CACHEBUST="default"

RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.edge.kernel.org/g' /etc/apk/repositories
RUN --mount=type=cache,id=common-tools-alpine-apk-cache,target=/var/cache/apk,sharing=locked \
    apk add \
    bash \
    binutils \
    ca-certificates \
    curl \
    git \
    make;

# Download tini-static once and expose a stable common-tools path for consumers.
RUN --mount=type=cache,id=common-tools-tini-dl-${TINI_REF},target=/var/cache/dockypody/tini,sharing=locked \
    set -eu; \
    cached="/var/cache/dockypody/tini/tini-static"; \
    if [ -s "$cached" ]; then \
      "$cached" --version >/dev/null 2>&1 || rm -f "$cached"; \
    fi; \
    if [ ! -s "$cached" ]; then \
      tmp="${cached}.tmp"; \
      rm -f "$tmp"; \
      curl -fsSL --retry 3 --retry-delay 2 --connect-timeout 30 --max-time 600 -o "$tmp" \
        "${TINI_URL}/releases/download/${TINI_REF}/tini-static"; \
      mv "$tmp" "$cached"; \
    fi; \
    install -m 0755 "$cached" /usr/bin/tini-static

# Copy UPX and verify
COPY --from=upx-build /src/upx/build/upx /usr/local/bin/upx
RUN upx --version || (echo "UPX verification failed" && exit 1)

# Download and minify nushell
# Use musl build (statically linked) for all platforms.
RUN --mount=type=cache,id=common-tools-nushell-dl-${NUSHELL_REF},target=/var/cache/dockypody/nushell,sharing=locked \
    set -eu; \
    tarball="/var/cache/dockypody/nushell/nu-${NUSHELL_REF}-x86_64-unknown-linux-musl.tar.gz"; \
    if [ -s "$tarball" ]; then \
      tar -tzf "$tarball" >/dev/null 2>&1 || rm -f "$tarball"; \
    fi; \
    if [ ! -s "$tarball" ]; then \
      tmp="${tarball}.tmp"; \
      rm -f "$tmp"; \
      curl -fsSL --retry 3 --retry-delay 2 --connect-timeout 30 --max-time 600 -o "$tmp" \
        "${NUSHELL_URL}/releases/download/${NUSHELL_REF}/nu-${NUSHELL_REF}-x86_64-unknown-linux-musl.tar.gz"; \
      mv "$tmp" "$tarball"; \
    fi; \
    tar -xzf "$tarball" -C /tmp --strip-components=1; \
    strip -s /tmp/nu; \
    upx -qq --best --lzma /tmp/nu; \
    upx -t /tmp/nu; \
    mv /tmp/nu /usr/local/bin/nu; \
    chmod +x /usr/local/bin/nu

# Verify all tools
RUN nu --version || (echo "Nushell verification failed" && exit 1) \
    && upx --version || (echo "UPX verification failed" && exit 1) \
    && tini-static --version || (echo "tini verification failed" && exit 1) \
    && curl --version || (echo "curl verification failed" && exit 1) \
    && git --version || (echo "git verification failed" && exit 1) \
    && make --version || (echo "make verification failed" && exit 1) \
    && bash --version || (echo "bash verification failed" && exit 1)

COPY ./tls/certificate-authority/ /tmp/tls-ca-source/
RUN if [ "$TLS_ENABLED" = "true" ]; then \
    if [ -z "$TLS_CA_NAME" ]; then \
    echo "Error: TLS_CA_NAME must be provided when TLS_ENABLED=true" && exit 1; \
    fi && \
    mkdir -p /usr/local/share/ca-certificates && \
    cp /tmp/tls-ca-source/${TLS_CA_NAME}.crt /usr/local/share/ca-certificates/ 2>/dev/null || \
    (echo "Error: CA file ${TLS_CA_NAME}.crt not found" && exit 1) && \
    update-ca-certificates && \
    rm -rf /tmp/tls-ca-source; \
    else \
    rm -rf /tmp/tls-ca-source; \
    fi

FROM tools
