OCIS_IMAGE=ocis:v8.0.1
MITMPROXY_IMAGE=mitmproxy:v12.2.2
FIREFOX_IMAGE=firefox:v150.0.0

OCIS1_URL=https://ocis1.docker
OCIS2_URL=https://ocis2.docker
OCIS1_TLS_CERT_NAME=ocis1
OCIS2_TLS_CERT_NAME=ocis2
OCIS1_ADMIN_PASSWORD=admin
OCIS2_ADMIN_PASSWORD=admin
OCIS_LOG_LEVEL=info
OCIS_LOG_PRETTY=true
OCIS_INSECURE=true
OCIS1_INIT=true
OCIS2_INIT=true
DEMO_USERS=true
START_ADDITIONAL_SERVICES=ocm
OCIS_HTTP_PROXY=http://ocis-mitmproxy.docker:8080
OCIS_HTTPS_PROXY=http://ocis-mitmproxy.docker:8080
OCIS1_NO_PROXY=localhost,127.0.0.1,ocis-mitmproxy.docker,ocis1.docker
OCIS2_NO_PROXY=localhost,127.0.0.1,ocis-mitmproxy.docker,ocis2.docker

FIREFOX_UI_PORT=5800
FIREFOX_START_URL=https://ocis1.docker/
MITM_CA_NAME=dockypody
