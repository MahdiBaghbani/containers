OPENCLOUD_IMAGE=opencloud:v6.1.0
MITMPROXY_IMAGE=mitmproxy:v12.2.2
FIREFOX_IMAGE=firefox:v150.0.0

OPENCLOUD1_URL=https://opencloud1.docker
OPENCLOUD2_URL=https://opencloud2.docker
OPENCLOUD1_TLS_CERT_NAME=opencloud1
OPENCLOUD2_TLS_CERT_NAME=opencloud2
OPENCLOUD1_ADMIN_PASSWORD=admin
OPENCLOUD2_ADMIN_PASSWORD=admin
OPENCLOUD_LOG_LEVEL=info
OPENCLOUD_LOG_PRETTY=true
OPENCLOUD_INSECURE=true
OPENCLOUD1_INIT=true
OPENCLOUD2_INIT=true
DEMO_USERS=true
START_ADDITIONAL_SERVICES=ocm
OPENCLOUD_HTTP_PROXY=http://opencloud-mitmproxy.docker:8080
OPENCLOUD_HTTPS_PROXY=http://opencloud-mitmproxy.docker:8080
OPENCLOUD1_NO_PROXY=localhost,127.0.0.1,opencloud-mitmproxy.docker,opencloud1.docker
OPENCLOUD2_NO_PROXY=localhost,127.0.0.1,opencloud-mitmproxy.docker,opencloud2.docker

FIREFOX_UI_PORT=5800
FIREFOX_START_URL=https://opencloud1.docker/
MITM_CA_NAME=dockypody
