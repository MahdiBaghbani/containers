# Dev-only two-cernbox example stack (no production variant in this example).
#
# Image versions for this example stack.
# - cernbox-revad: master-development (Reva master band, development platform)
# - cernbox-web: master (default tracked web lane; web-extensions pin in
#   services/cernbox-web/versions.nuon)
# - idp: direct local-network HTTPS using the baked idp.docker certificate
# - mitmproxy: best-effort server-to-server OCM capture for the local lab
IMAGE_CERNBOX_REVAD=master-development
IMAGE_CERNBOX_WEB=master
IMAGE_IDP=v26.4.2
MITMPROXY_IMAGE=mitmproxy:v12.2.2
FIREFOX_IMAGE=firefox:v150.0.0

# Host browser access
FIREFOX_UI_PORT=5803
FIREFOX_START_URL=https://cernbox1.docker/

# Shared Keycloak direct local-network HTTPS endpoint.
# Keep 443 for parity with the older CERNBox test-suite contract and the
# default OIDC URL shape used across the baked realm/client setup.
IDP_DOMAIN=idp.docker
IDP_PORT=443
IDP_PROTOCOL=https
IDP_URL=https://idp.docker

# MITM proxy settings (best effort only; Reva-side live capture is not guaranteed
# without Reva transport changes, but the lab should expose the right topology).
MITM_CA_NAME=dockypody
CERNBOX_HTTP_PROXY=http://mitm:8080
CERNBOX_HTTPS_PROXY=http://mitm:8080

# CERNBox instance 1 browser-facing and provider domains.
CERNBOX1_DOMAIN=cernbox1.docker
CERNBOX1_REVAD_DOMAIN=cernbox1.docker
CERNBOX1_NO_PROXY=localhost,127.0.0.1,mitm,idp.docker,cernbox1.docker,two-cernbox-1-revad-gateway,two-cernbox-1-revad-dataprovider-localhome,two-cernbox-1-revad-dataprovider-ocm,two-cernbox-1-revad-dataprovider-sciencemesh,two-cernbox-1-revad-authprovider-oidc,two-cernbox-1-revad-authprovider-machine,two-cernbox-1-revad-authprovider-ocmshares,two-cernbox-1-revad-authprovider-ocmsharecode,two-cernbox-1-revad-authprovider-ocmexchangedtoken,two-cernbox-1-revad-authprovider-publicshares,two-cernbox-1-revad-shareproviders,two-cernbox-1-revad-groupuserproviders

# CERNBox instance 2 browser-facing and provider domains.
CERNBOX2_DOMAIN=cernbox2.docker
CERNBOX2_REVAD_DOMAIN=cernbox2.docker
CERNBOX2_NO_PROXY=localhost,127.0.0.1,mitm,idp.docker,cernbox2.docker,two-cernbox-2-revad-gateway,two-cernbox-2-revad-dataprovider-localhome,two-cernbox-2-revad-dataprovider-ocm,two-cernbox-2-revad-dataprovider-sciencemesh,two-cernbox-2-revad-authprovider-oidc,two-cernbox-2-revad-authprovider-machine,two-cernbox-2-revad-authprovider-ocmshares,two-cernbox-2-revad-authprovider-ocmsharecode,two-cernbox-2-revad-authprovider-ocmexchangedtoken,two-cernbox-2-revad-authprovider-publicshares,two-cernbox-2-revad-shareproviders,two-cernbox-2-revad-groupuserproviders

# TLS / protocol split:
# - Reva microservices stay HTTP internally.
# - cernbox-web and idp serve HTTPS directly on the compose network.
REVAD_TLS_ENABLED=false
REVAD_PORT=80
REVAD_PROTOCOL=http
WEB_TLS_ENABLED=true
WEB_PROTOCOL=https

# Shared gateway and microservice port layout.
# Ports match CERN production patterns for easier debugging.
REVAD_GATEWAY_PORT=80
REVAD_GATEWAY_PROTOCOL=http
REVAD_GATEWAY_GRPC_PORT=9142
REVAD_DATAPROVIDER_LOCALHOME_PORT=80
REVAD_DATAPROVIDER_LOCALHOME_PROTOCOL=http
REVAD_DATAPROVIDER_LOCALHOME_GRPC_PORT=9143
REVAD_DATAPROVIDER_OCM_PORT=80
REVAD_DATAPROVIDER_OCM_PROTOCOL=http
REVAD_DATAPROVIDER_OCM_GRPC_PORT=9146
REVAD_DATAPROVIDER_SCIENCEMESH_PORT=80
REVAD_DATAPROVIDER_SCIENCEMESH_PROTOCOL=http
REVAD_DATAPROVIDER_SCIENCEMESH_GRPC_PORT=9147
REVAD_AUTHPROVIDER_OIDC_GRPC_PORT=9158
REVAD_AUTHPROVIDER_MACHINE_GRPC_PORT=9166
REVAD_AUTHPROVIDER_OCMSHARES_GRPC_PORT=9278
REVAD_AUTHPROVIDER_OCMSHARECODE_GRPC_PORT=9280
REVAD_AUTHPROVIDER_OCMEXCHANGEDTOKEN_GRPC_PORT=9282
REVAD_AUTHPROVIDER_PUBLICSHARES_GRPC_PORT=9160
REVAD_SHAREPROVIDERS_GRPC_PORT=9144
REVAD_GROUPUSERPROVIDERS_GRPC_PORT=9145

# CERNBox 1 Reva mesh hostnames (must match container_name values in compose).
CERNBOX1_REVAD_GATEWAY_HOST=two-cernbox-1-revad-gateway
CERNBOX1_REVAD_DATAPROVIDER_LOCALHOME_HOST=two-cernbox-1-revad-dataprovider-localhome
CERNBOX1_REVAD_DATAPROVIDER_OCM_HOST=two-cernbox-1-revad-dataprovider-ocm
CERNBOX1_REVAD_DATAPROVIDER_SCIENCEMESH_HOST=two-cernbox-1-revad-dataprovider-sciencemesh
CERNBOX1_REVAD_AUTHPROVIDER_OIDC_HOST=two-cernbox-1-revad-authprovider-oidc
CERNBOX1_REVAD_AUTHPROVIDER_MACHINE_HOST=two-cernbox-1-revad-authprovider-machine
CERNBOX1_REVAD_AUTHPROVIDER_OCMSHARES_HOST=two-cernbox-1-revad-authprovider-ocmshares
CERNBOX1_REVAD_AUTHPROVIDER_OCMSHARECODE_HOST=two-cernbox-1-revad-authprovider-ocmsharecode
CERNBOX1_REVAD_AUTHPROVIDER_OCMEXCHANGEDTOKEN_HOST=two-cernbox-1-revad-authprovider-ocmexchangedtoken
CERNBOX1_REVAD_AUTHPROVIDER_PUBLICSHARES_HOST=two-cernbox-1-revad-authprovider-publicshares
CERNBOX1_REVAD_SHAREPROVIDERS_HOST=two-cernbox-1-revad-shareproviders
CERNBOX1_REVAD_GROUPUSERPROVIDERS_HOST=two-cernbox-1-revad-groupuserproviders

# CERNBox 2 Reva mesh hostnames (must match container_name values in compose).
CERNBOX2_REVAD_GATEWAY_HOST=two-cernbox-2-revad-gateway
CERNBOX2_REVAD_DATAPROVIDER_LOCALHOME_HOST=two-cernbox-2-revad-dataprovider-localhome
CERNBOX2_REVAD_DATAPROVIDER_OCM_HOST=two-cernbox-2-revad-dataprovider-ocm
CERNBOX2_REVAD_DATAPROVIDER_SCIENCEMESH_HOST=two-cernbox-2-revad-dataprovider-sciencemesh
CERNBOX2_REVAD_AUTHPROVIDER_OIDC_HOST=two-cernbox-2-revad-authprovider-oidc
CERNBOX2_REVAD_AUTHPROVIDER_MACHINE_HOST=two-cernbox-2-revad-authprovider-machine
CERNBOX2_REVAD_AUTHPROVIDER_OCMSHARES_HOST=two-cernbox-2-revad-authprovider-ocmshares
CERNBOX2_REVAD_AUTHPROVIDER_OCMSHARECODE_HOST=two-cernbox-2-revad-authprovider-ocmsharecode
CERNBOX2_REVAD_AUTHPROVIDER_OCMEXCHANGEDTOKEN_HOST=two-cernbox-2-revad-authprovider-ocmexchangedtoken
CERNBOX2_REVAD_AUTHPROVIDER_PUBLICSHARES_HOST=two-cernbox-2-revad-authprovider-publicshares
CERNBOX2_REVAD_SHAREPROVIDERS_HOST=two-cernbox-2-revad-shareproviders
CERNBOX2_REVAD_GROUPUSERPROVIDERS_HOST=two-cernbox-2-revad-groupuserproviders

# Shared configuration (used by all containers)
REVAD_LOG_LEVEL=debug
REVAD_LOG_OUTPUT=/var/log/revad.log
REVAD_JWT_SECRET=reva-secret

# Optional: OCM shares JSON file path (default: /var/tmp/reva/shares.json)
# REVAD_OCMSHARES_JSON_FILE=/var/tmp/reva/shares.json

# Optional: Mesh Directory configuration for the Reva gateway only.
# Consumed by revad-base init-gateway.nu as mesh_directory_url in ScienceMesh
# config. Not passed to cernbox-web; no frontend JS rewrite is involved.
# MESHDIR_DOMAIN=meshdir.docker
# MESHDIR_URL=https://meshdir.docker/meshdir

# OCM code-flow token exchange (requires matching Reva build with code-flow support)
OCM_ENABLE_CODE_FLOW=true
OCM_TIMEOUT=10
OCM_CLIENT_INSECURE=false

# Optional: Directory Service URLs (new, for directory_service_urls field)
# Space-separated list of directory service URLs for ScienceMesh WAYF handler
# Independent of MESHDIR_URL/MESHDIR_DOMAIN (mesh_directory_url field)
# Invalid URLs are automatically removed with warnings
OCM_DIRECTORY_SERVICE_URLS="https://surfdrive.surf.nl/index.php/s/d0bE1k3P1WHReTq/download"

# Optional: Rclone endpoint (for DataTX transfers)
# RCLONE_ENDPOINT=http://rclone.docker

# Optional: Reva config directory (default: /etc/revad)
# REVAD_CONFIG_DIR=/etc/revad

# Logging
LOG_LEVEL=debug
LOG_PRETTY=true
