# Images (built locally via DockyPody)
MITMPROXY_IMAGE=mitmproxy:v1.0.0
FIREFOX_IMAGE=firefox:v1.0.0
IMAGE_NEXTCLOUD_CONTACTS=local-debian
IMAGE_MARIADB=11.8
IMAGE_VALKEY=9.0-alpine

# Host ports
FIREFOX_UI_PORT=5800

# Firefox start URL (autostart)
FIREFOX_START_URL=https://mitmproxy.docker/

# mitmproxy (mitmweb UI uses https://mitmproxy.docker/)
MITM_CA_NAME=dockypody

# Nextcloud common
NEXTCLOUD_HTTPS_MODE=https-only
NEXTCLOUD_APACHE_LOGLEVEL=warn
CONTACTS_ENABLE_OCM_INVITES=true
CONTACTS_OCM_INVITES_MODE=advanced

# Nextcloud 1
NEXTCLOUD1_APACHE_SERVER_NAME=nextcloud1.docker
NEXTCLOUD1_NEXTCLOUD_TRUSTED_DOMAINS=nextcloud1.docker
NEXTCLOUD1_NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD1_NEXTCLOUD_ADMIN_PASSWORD=admin
NEXTCLOUD1_MYSQL_ROOT_PASSWORD=rootpassword
NEXTCLOUD1_MYSQL_DATABASE=nextcloud
NEXTCLOUD1_MYSQL_USER=nextcloud
NEXTCLOUD1_MYSQL_PASSWORD=nextcloudpassword
NEXTCLOUD1_NO_PROXY=localhost,127.0.0.1,mitmproxy.docker,marianextcloud1,valkeynextcloud1

# Nextcloud 2
NEXTCLOUD2_APACHE_SERVER_NAME=nextcloud2.docker
NEXTCLOUD2_NEXTCLOUD_TRUSTED_DOMAINS=nextcloud2.docker
NEXTCLOUD2_NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD2_NEXTCLOUD_ADMIN_PASSWORD=admin
NEXTCLOUD2_MYSQL_ROOT_PASSWORD=rootpassword
NEXTCLOUD2_MYSQL_DATABASE=nextcloud
NEXTCLOUD2_MYSQL_USER=nextcloud
NEXTCLOUD2_MYSQL_PASSWORD=nextcloudpassword
NEXTCLOUD2_NO_PROXY=localhost,127.0.0.1,mitmproxy.docker,marianextcloud2,valkeynextcloud2

# Server-to-server proxying (Nextcloud outbound HTTP(S))
NEXTCLOUD_HTTP_PROXY=http://mitmproxy.docker:8080
NEXTCLOUD_HTTPS_PROXY=http://mitmproxy.docker:8080
